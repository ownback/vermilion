# Defence in depth on top of the whitelist copy (security audit 2026-11-04, repo B)
*.rom
*.edid.bin
*.kc
*.MOV
*.mov
*.heic
config*.plist
!src/**/Info.plist
opencore-*.txt
# the release's OpenCore fragment and README: templates with no machine values (scripts/release/make-oc-zip.sh)
!scripts/release/config-snippet.plist
!scripts/release/OpenCore-README.txt
*.tgz
*.zip
.DS_Store
._*
/build/
src/**/build/
*.dylib
*.kext/
# codeless kexts kept as plist source for the EFI (efi/README.md)
!efi/kexts/*.kext/
# Local build inputs that must never be committed: AMD firmware and the header of its hashes (no firmware bytes)
*.bin
src/vermilion-boot/phx_c3_hash.inc
# the generated C3 image of builds before b163 (AMD firmware bytes); a checkout that built one still has it
src/vermilion-boot/phx_c3_image.inc
*.o
*.bundle/
*.dSYM/
__pycache__/
target/
*.pyc
/deps/
# generated per machine from the installed Vermilion code (gen_list.sh)
src/vermilion-trust/phxtrust_list.inc
# agent tooling: per-checkout code index, Serena's local state, personal Claude Code settings
compile_commands.json
/.serena/
.claude/settings.local.json
