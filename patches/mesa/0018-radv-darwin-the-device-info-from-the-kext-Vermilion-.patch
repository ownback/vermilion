 struct acd_bo_created {
diff --git a/src/amd/common/darwin/test/acd_devinfo_test.c b/src/amd/common/darwin/test/acd_devinfo_test.c
new file mode 100644
index 0000000..b7b8734
--- /dev/null
+++ b/src/amd/common/darwin/test/acd_devinfo_test.c
@@ -0,0 +1,176 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Host test of the kext device info mapping (ac_darwin_devinfo.h).  Build and run:
+ *   clang -std=gnu11 -Wall -Wextra -I include -I include/darwin -I src/amd/common/darwin \
+ *     src/amd/common/darwin/test/acd_devinfo_test.c -o acd_devinfo_test && ./acd_devinfo_test
+ * The kext record is made up here in the shape the kext builds for an RX 7900 XTX (no values read from a machine).
+ */
+#include "ac_darwin_devinfo.h"
+
+#include <string.h>
+
+static int failures, checks;
+#define CHECK(c) do { checks++; if (!(c)) { failures++; printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static struct n48n_devinfo
+xtx(void)
+{
+   struct n48n_devinfo k;
+   memset(&k, 0, sizeof(k));
+   k.version = N48N_DEVINFO_VERSION;
+   k.size = sizeof(k);
+   k.flags = N48N_DEV_VALID | N48N_DEV_GC_REGS | N48N_DEV_CU_PER_SA_FULL | N48N_DEV_VRAM_FROM_UMC |
+             N48N_DEV_CLOCKS_DEFAULT | N48N_DEV_FW_DEFAULT;
+   k.device_id = 0x744c;
+   k.pci_rev = 0xc8;
+   k.external_rev = 1;
+   k.family = AMDGPU_FAMILY_GC_11_0_0;
+   k.gc_ip = 0xb0000;
+   k.num_se = 6;
+   k.num_sa_per_se = 2;
+   k.num_cu_per_sa = 8;
+   k.cu_active_number = 96;
+   k.num_rb_pipes = 24;
+   k.enabled_rb_pipes_mask = 0xffffff;
+   k.num_tcc_blocks = 24;
+   k.num_hw_gfx_contexts = 8;
+   for (unsigned r = 0; r < 4; r++) {
+      k.cu_bitmap[r][0] = k.cu_bitmap[r][1] = 0xff;
+      k.cu_bitmap[r][2] = k.cu_bitmap[r][3] = r < 2 ? 0xff : 0;
+   }
+   k.gb_addr_config = 0x545;
+   k.num_gprs = 1536;
+   k.max_gs_waves_per_vgt = 32;
+   k.gs_vgt_table_depth = 32;
+   k.gs_prim_buffer_depth = 1792;
+   k.wave_size = 32;
+   k.tcp_cache_kb = 32;
+   k.num_sqc_per_wgp = 1;
+   k.sqc_inst_cache_kb = 32;
+   k.sqc_data_cache_kb = 16;
+   k.gl1c_cache_kb = 256;
+   k.gl2c_cache_kb = 6144;
+   k.vram_type = AMDGPU_VRAM_TYPE_GDDR6;
+   k.vram_bit_width = 384;
+   k.mall_size = 96ull << 20;
+   k.pcie_gen = 4;
+   k.pcie_num_lanes = 16;
+   k.gpu_counter_khz = 100000;
+   k.max_engine_khz = 2371000;
+   k.min_engine_khz = 500000;
+   k.max_memory_khz = 1249000;
+   k.min_memory_khz = 96000;
+   k.fw_me = 2420;
+   k.fw_pfp = 2580;
+   k.fw_mec = 2650;
+   k.fw_me_feature = k.fw_pfp_feature = k.fw_mec_feature = 29;
+   strcpy(k.name, "AMD Radeon RX 7900 XTX");
+   return k;
+}
+
+int
+main(void)
+{
+   _Static_assert(sizeof(struct n48n_devinfo) == 512, "devinfo");
+   struct n48n_devinfo k = xtx();
+   CHECK(acd_devinfo_usable(&k));
+
+   /* a template with driver-side values that must survive, and hardware values that must not */
+   struct drm_amdgpu_info_device di;
+   memset(&di, 0, sizeof(di));
+   di.virtual_address_offset = 0x200000;
+   di.virtual_address_max = 0x800000000000ull;
+   di.high_va_offset = 0xffff800000000000ull;
+   di.high_va_max = 0xffffffffffe00000ull;
+   di.virtual_address_alignment = 4096;
+   di.pte_fragment_size = 2 << 20;
+   di.gart_page_size = 4096;
+   di.ids_flags = 0x8;
+   di.num_shader_engines = 4;
+   di.cu_active_number = 84;
+   di.vram_bit_width = 320;
+   char names[512];
+   unsigned n = acd_devinfo_apply(&di, &k, names, sizeof(names));
+   CHECK(n > 10);
+   CHECK(strstr(names, "num_shader_engines") && strstr(names, "cu_active_number") && strstr(names, "vram_bit_width"));
+   CHECK(strstr(names, "cu_bitmap"));
+   CHECK(di.virtual_address_offset == 0x200000 && di.virtual_address_max == 0x800000000000ull);
+   CHECK(di.high_va_offset == 0xffff800000000000ull && di.high_va_max == 0xffffffffffe00000ull);
+   CHECK(di.pte_fragment_size == 2 << 20 && di.gart_page_size == 4096 && di.ids_flags == 0x8);
+   CHECK(di.device_id == 0x744c && di.pci_rev == 0xc8 && di.external_rev == 1 && di.family == AMDGPU_FAMILY_GC_11_0_0);
+   CHECK(di.num_shader_engines == 6 && di.num_shader_arrays_per_engine == 2 && di.num_cu_per_sh == 8);
+   CHECK(di.cu_active_number == 96 && di.cu_bitmap[1][3] == 0xff && di.cu_bitmap[3][3] == 0);
+   CHECK(di.num_rb_pipes == 24 && di.enabled_rb_pipes_mask == 0xffffff && di.enabled_rb_pipes_mask_hi == 0);
+   CHECK(di.num_tcc_blocks == 24 && di.tcc_disabled_mask == 0 && di.num_hw_gfx_contexts == 8);
+   CHECK(di.vram_type == AMDGPU_VRAM_TYPE_GDDR6 && di.vram_bit_width == 384 && di.mall_size == 96ull << 20);
+   CHECK(di.tcp_cache_size == 32 && di.sqc_inst_cache_size == 32 && di.sqc_data_cache_size == 16);
+   CHECK(di.gl1c_cache_size == 256 && di.gl2c_cache_size == 6144 && di.num_sqc_per_wgp == 1);
+   CHECK(di.gpu_counter_freq == 100000 && di.max_engine_clock == 2371000 && di.min_memory_clock == 96000);
+   CHECK(di.pcie_gen == 4 && di.pcie_num_lanes == 16);
+   CHECK(di.num_shader_visible_vgprs == 1536 && di.gs_prim_buffer_depth == 1792 && di.wave_front_size == 32);
+   /* applying the same record again changes nothing */
+   CHECK(acd_devinfo_apply(&di, &k, names, sizeof(names)) == 0 && names[0] == 0);
+   /* unknown values (0) keep the template's: PCIe from a registry without the property, VRAM without UMC 8.10 */
+   k.pcie_gen = k.pcie_num_lanes = 0;
+   k.vram_type = k.vram_bit_width = 0;
+   CHECK(acd_devinfo_apply(&di, &k, NULL, 0) == 0 && di.pcie_gen == 4 && di.vram_bit_width == 384);
+   /* a short names buffer is truncated, never overrun */
+   char tiny[8];
+   memset(&di, 0, sizeof(di));
+   k = xtx();
+   CHECK(acd_devinfo_apply(&di, &k, tiny, sizeof(tiny)) > 10 && strlen(tiny) < sizeof(tiny));
+
+   /* HW_IP and FW */
+   struct drm_amdgpu_info_hw_ip ip = {.hw_ip_version_major = 1, .ib_start_alignment = 32, .available_rings = 1};
+   acd_devinfo_hw_ip(&ip, k.gc_ip);
+   CHECK(ip.hw_ip_version_major == 11 && ip.hw_ip_version_minor == 0 && ip.ip_discovery_version == 0xb0000);
+   CHECK(ip.ib_start_alignment == 32 && ip.available_rings == 1);
+   acd_devinfo_hw_ip(&ip, 0);
+   CHECK(ip.hw_ip_version_major == 11);
+   struct drm_amdgpu_info_firmware fw = {.ver = 1486, .feature = 29};
+   acd_devinfo_fw(&fw, AMDGPU_INFO_FW_GFX_ME, &k);
+   CHECK(fw.ver == 2420 && fw.feature == 29);
+   acd_devinfo_fw(&fw, AMDGPU_INFO_FW_GFX_PFP, &k);
+   CHECK(fw.ver == 2580);
+   acd_devinfo_fw(&fw, AMDGPU_INFO_FW_GFX_MEC, &k);
+   CHECK(fw.ver == 2650);
+   fw.ver = 7;
+   acd_devinfo_fw(&fw, AMDGPU_INFO_FW_VCN, &k);
+   CHECK(fw.ver == 7);
+
+   /* the whole FW_VERSION answer: VCN keeps its version with the kext's record too (0 would turn video off) */
+   const struct drm_amdgpu_info_firmware me = {.ver = 1486, .feature = 29}, pfp = {.ver = 1525, .feature = 29},
+                                         mec = {.ver = 494, .feature = 29};
+   memset(&fw, 0, sizeof(fw));
+   acd_fw_version(&fw, AMDGPU_INFO_FW_VCN, &me, &pfp, &mec, &k);
+   CHECK(fw.ver == ACD_FW_VCN_VERSION && fw.feature == 0);
+   memset(&fw, 0, sizeof(fw));
+   acd_fw_version(&fw, AMDGPU_INFO_FW_VCN, &me, &pfp, &mec, NULL);
+   CHECK(fw.ver == ACD_FW_VCN_VERSION);
+   acd_fw_version(&fw, AMDGPU_INFO_FW_GFX_ME, &me, &pfp, &mec, &k);
+   CHECK(fw.ver == 2420 && fw.feature == 29);
+   acd_fw_version(&fw, AMDGPU_INFO_FW_GFX_PFP, &me, &pfp, &mec, NULL);
+   CHECK(fw.ver == 1525);
+   acd_fw_version(&fw, AMDGPU_INFO_FW_GFX_MEC, &me, &pfp, &mec, &k);
+   CHECK(fw.ver == 2650);
+   fw.ver = 5;
+   acd_fw_version(&fw, AMDGPU_INFO_FW_SMC, &me, &pfp, &mec, &k);
+   CHECK(fw.ver == 5);
+
+   /* what makes a record unusable */
+   k = xtx();
+   k.flags &= ~N48N_DEV_VALID;
+   CHECK(!acd_devinfo_usable(&k));
+   k = xtx();
+   k.version = 2;
+   CHECK(!acd_devinfo_usable(&k));
+   k = xtx();
+   k.size = 192;
+   CHECK(!acd_devinfo_usable(&k));
+   k = xtx();
+   k.num_cu_per_sa = 0;
+   CHECK(!acd_devinfo_usable(&k));
+
+   printf("acd_devinfo_test: %d/%d checks passed\n", checks - failures, checks);
+   return failures ? 1 : 0;
+}
